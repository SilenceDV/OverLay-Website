<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>BAAO Overlay Maker</title>

<style>
* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
  background: transparent;
  overflow: hidden;
  font-family: Arial, sans-serif;
}

/* MAIN APP */
#app {
  width: 100vw;
  height: 100vh;
  display: flex;
  background: #111;
  color: white;
}

/* LEFT EDITOR */
#editor {
  width: 390px;
  height: 100vh;
  overflow-y: auto;
  background: #181818;
  border-right: 2px solid #333;
  padding: 16px;
}

h1 {
  font-size: 24px;
  margin: 0 0 14px;
}

label {
  font-size: 13px;
  opacity: 0.8;
}

input, select, button {
  width: 100%;
  padding: 10px;
  margin: 6px 0 12px;
  border-radius: 8px;
  border: none;
  font-size: 15px;
}

input, select {
  background: #2b2b2b;
  color: white;
}

button {
  background: #00aaff;
  color: white;
  font-weight: 800;
  cursor: pointer;
}

button:hover {
  opacity: 0.85;
}

.danger {
  background: #d93636;
}

.good {
  background: #17a34a;
}

.slideBox {
  background: #242424;
  border: 1px solid #3a3a3a;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 14px;
}

.slideBox img {
  width: 100%;
  height: 120px;
  object-fit: contain;
  background: #000;
  border-radius: 8px;
  margin-bottom: 8px;
}

/* OVERLAY AREA */
#overlayArea {
  flex: 1;
  position: relative;
  overflow: hidden;
  background: transparent;
}

#overlayContent {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 520px;
  transform: translate(-50%, -50%);
  text-align: center;
  opacity: 1;
  transition: opacity 0.6s ease-in-out;
}

#overlayImage {
  width: 350px;
  max-height: 420px;
  object-fit: contain;
}

#overlayText {
  margin-top: 10px;
  font-size: 64px;
  font-weight: 1000;
  line-height: 1;
  -webkit-text-stroke: 6px black;
  paint-order: stroke fill;
}

/* TEXT EFFECTS */
.solid {
  color: #57fff4;
  filter: drop-shadow(0 0 10px #00ffff);
}

.rainbow {
  color: transparent;
  background: linear-gradient(
    90deg,
    #00f5ff,
    #00ff88,
    #ffe600,
    #ff7b00,
    #ff00ff,
    #00f5ff
  );
  background-size: 400%;
  -webkit-background-clip: text;
  background-clip: text;
  animation: rainbowMove 4s linear infinite;
  filter: drop-shadow(0 0 12px #00f5ff);
}

.aurora {
  color: transparent;
  background: linear-gradient(
    120deg,
    #00eaff,
    #7bffb2,
    #b57cff,
    #00aaff,
    #ff8cff
  );
  background-size: 300% 300%;
  -webkit-background-clip: text;
  background-clip: text;
  animation: auroraFlow 5s ease-in-out infinite;
  filter: drop-shadow(0 0 14px #7bffb2);
}

.baao {
  color: transparent;
  background: linear-gradient(
    90deg,
    #009dff,
    #00eaff,
    #ff7b00,
    #ffb000,
    #009dff
  );
  background-size: 400%;
  -webkit-background-clip: text;
  background-clip: text;
  animation: rainbowMove 4s linear infinite;
  filter: drop-shadow(0 0 14px #009dff);
}

.fire {
  color: transparent;
  background: linear-gradient(
    90deg,
    #fff000,
    #ff9d00,
    #ff3300,
    #ff0000,
    #fff000
  );
  background-size: 300%;
  -webkit-background-clip: text;
  background-clip: text;
  animation: rainbowMove 3s linear infinite;
  filter: drop-shadow(0 0 15px #ff3300);
}

.ice {
  color: transparent;
  background: linear-gradient(
    90deg,
    #ffffff,
    #9effff,
    #00c8ff,
    #ffffff
  );
  background-size: 300%;
  -webkit-background-clip: text;
  background-clip: text;
  animation: rainbowMove 4s linear infinite;
  filter: drop-shadow(0 0 15px #00d9ff);
}

@keyframes rainbowMove {
  0% { background-position: 0%; }
  100% { background-position: 400%; }
}

@keyframes auroraFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* OVERLAY ONLY MODE */
body.overlayOnly #editor {
  display: none;
}

body.overlayOnly #app {
  background: transparent;
}

body.overlayOnly #overlayArea {
  width: 100vw;
  height: 100vh;
}
</style>
</head>

<body>

<div id="app">

  <div id="editor">
    <h1>BAAO Overlay Maker</h1>

    <label>Preset Name</label>
    <input id="presetName" placeholder="Example: Subway Surfers">

    <button onclick="addSlide()">Add PNG Slide</button>
    <button class="good" onclick="savePreset()">Save Preset</button>

    <label>Load Preset</label>
    <select id="presetSelect" onchange="loadPreset(this.value)">
      <option value="">Select preset...</option>
    </select>

    <button onclick="startOverlay()">Start Rotation</button>
    <button onclick="stopOverlay()">Stop Rotation</button>

    <label>Seconds Per Slide</label>
    <input id="speedInput" type="number" value="5" min="1">

    <button onclick="toggleOverlayOnly()">Overlay Only Mode</button>

    <hr>

    <div id="slidesContainer"></div>
  </div>

  <div id="overlayArea">
    <div id="overlayContent">
      <img id="overlayImage">
      <div id="overlayText" class="rainbow"></div>
    </div>
  </div>

</div>

<script>
let slides = [];
let currentIndex = 0;
let rotationTimer = null;

const overlayContent = document.getElementById("overlayContent");
const overlayImage = document.getElementById("overlayImage");
const overlayText = document.getElementById("overlayText");

function addSlide() {
  slides.push({
    image: "",
    text: "Tickle",
    effect: "rainbow"
  });

  renderSlides();
}

function renderSlides() {
  const container = document.getElementById("slidesContainer");
  container.innerHTML = "";

  slides.forEach((slide, index) => {
    const box = document.createElement("div");
    box.className = "slideBox";

    box.innerHTML = `
      <img src="${slide.image || ""}">

      <label>PNG File</label>
      <input type="file" accept="image/png,image/jpeg,image/webp" onchange="loadImage(event, ${index})">

      <label>Words Under PNG</label>
      <input value="${escapeHtml(slide.text)}" oninput="updateText(${index}, this.value)">

      <label>Text Effect</label>
      <select onchange="updateEffect(${index}, this.value)">
        <option value="solid" ${slide.effect === "solid" ? "selected" : ""}>Solid Glow</option>
        <option value="rainbow" ${slide.effect === "rainbow" ? "selected" : ""}>Rainbow</option>
        <option value="aurora" ${slide.effect === "aurora" ? "selected" : ""}>Aurora</option>
        <option value="baao" ${slide.effect === "baao" ? "selected" : ""}>BAAO Blue/Orange</option>
        <option value="fire" ${slide.effect === "fire" ? "selected" : ""}>Fire</option>
        <option value="ice" ${slide.effect === "ice" ? "selected" : ""}>Ice</option>
      </select>

      <button onclick="moveSlideUp(${index})">Move Up</button>
      <button onclick="moveSlideDown(${index})">Move Down</button>
      <button class="danger" onclick="removeSlide(${index})">Remove Slide</button>
    `;

    container.appendChild(box);
  });
}

function loadImage(event, index) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();

  reader.onload = function(e) {
    slides[index].image = e.target.result;
    renderSlides();
    showSlide(currentIndex);
  };

  reader.readAsDataURL(file);
}

function updateText(index, value) {
  slides[index].text = value;
  showSlide(currentIndex);
}

function updateEffect(index, value) {
  slides[index].effect = value;
  showSlide(currentIndex);
}

function removeSlide(index) {
  slides.splice(index, 1);

  if (currentIndex >= slides.length) {
    currentIndex = 0;
  }

  renderSlides();
  showSlide(currentIndex);
}

function moveSlideUp(index) {
  if (index === 0) return;

  const temp = slides[index];
  slides[index] = slides[index - 1];
  slides[index - 1] = temp;

  renderSlides();
}

function moveSlideDown(index) {
  if (index === slides.length - 1) return;

  const temp = slides[index];
  slides[index] = slides[index + 1];
  slides[index + 1] = temp;

  renderSlides();
}

function startOverlay() {
  if (slides.length === 0) return;

  clearInterval(rotationTimer);

  currentIndex = 0;
  showSlide(currentIndex);

  const seconds = Number(document.getElementById("speedInput").value) || 5;

  rotationTimer = setInterval(() => {
    overlayContent.style.opacity = 0;

    setTimeout(() => {
      currentIndex = (currentIndex + 1) % slides.length;
      showSlide(currentIndex);
      overlayContent.style.opacity = 1;
    }, 600);

  }, seconds * 1000);
}

function stopOverlay() {
  clearInterval(rotationTimer);
}

function showSlide(index) {
  if (slides.length === 0) return;

  const slide = slides[index];

  overlayImage.src = slide.image;
  overlayText.textContent = slide.text;

  overlayText.className = "";
  overlayText.classList.add(slide.effect);
}

function savePreset() {
  const name = document.getElementById("presetName").value.trim();

  if (!name) {
    alert("Type a preset name first.");
    return;
  }

  const presetData = {
    name: name,
    speed: document.getElementById("speedInput").value,
    slides: slides
  };

  localStorage.setItem("BAAO_PRESET_" + name, JSON.stringify(presetData));

  loadPresetList();

  alert("Preset saved.");
}

function loadPreset(name) {
  if (!name) return;

  const saved = localStorage.getItem("BAAO_PRESET_" + name);

  if (!saved) return;

  const presetData = JSON.parse(saved);

  document.getElementById("presetName").value = presetData.name;
  document.getElementById("speedInput").value = presetData.speed || 5;

  slides = presetData.slides || [];

  currentIndex = 0;

  renderSlides();
  showSlide(currentIndex);
}

function loadPresetList() {
  const select = document.getElementById("presetSelect");

  select.innerHTML = `<option value="">Select preset...</option>`;

  for (let i = 0; i < localStorage.length; i++) {
    const key = localStorage.key(i);

    if (key.startsWith("BAAO_PRESET_")) {
      const name = key.replace("BAAO_PRESET_", "");

      const option = document.createElement("option");
      option.value = name;
      option.textContent = name;

      select.appendChild(option);
    }
  }
}

function toggleOverlayOnly() {
  document.body.classList.toggle("overlayOnly");
}

function escapeHtml(text) {
  return String(text)
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");
}

loadPresetList();
addSlide();
showSlide(0);
</script>

</body>
</html>
